# ========================================
# DATABASE
# ========================================
# Turso Database (libSQL)
# Get yours at: https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ========================================
# RIOT GAMES API
# ========================================
# Get yours at: https://developer.riotgames.com/
# Production key required for public deployment
# BOTH keys must be set to the SAME value!
RIOT_API_KEY=RGAPI-your-riot-api-key-here
VITE_RIOT_API_KEY=RGAPI-your-riot-api-key-here

# ========================================
# OAUTH PROVIDERS
# ========================================
# Google OAuth
# Get yours at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord OAuth
# Get yours at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Twitch OAuth (optional)
# Get yours at: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# ========================================
# AI & SERVICES
# ========================================
# OpenAI API (for AI coaching)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
VITE_OPENAI_API_KEY=sk-your-openai-api-key-here

# Resend (for email delivery)
# Get yours at: https://resend.com/
RESEND_API_KEY=re_your-resend-api-key

# ========================================
# SECURITY
# ========================================
# Cloudflare Turnstile (bot protection)
# Get yours at: https://dash.cloudflare.com/
TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxx

# ========================================
# CLOUDFLARE BINDINGS (Pages only)
# ========================================
# These are configured in Cloudflare Pages Dashboard
# Settings → Functions → Bindings
# 
# D1 Database: MATCH_DB
# KV Namespace: MATCH_CACHE
